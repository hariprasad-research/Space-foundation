   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "t = np.linspace(0, 5, 100)\n",
    "\n",
    "s = 3 * t**2\n",
    "v = 6 * t\n",
    "\n",
    "plt.plot(t, s, label=\"Position: s(t) = 3t²\")\n",
    "plt.plot(t, v, label=\"Velocity: v(t) = 6t\")\n",
    "plt.xlabel(\"Time (seconds)\")\n",
    "plt.ylabel(\"Value\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  }
 ],
